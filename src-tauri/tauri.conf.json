{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RMC Toolkit",
  "mainBinaryName": "rmc-toolkit",
  "version": "../package.json",
  "identifier": "dev.kidix.rmc-toolkit",
  "build": {
    "beforeDevCommand": "bun run build:overlay && bunx vite --config vite.config.launcher.ts",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:overlay && bunx vite build --config vite.config.launcher.ts",
    "frontendDist": "../dist-launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RMC Toolkit",
        "url": "launcher.html",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
