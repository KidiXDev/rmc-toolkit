{
  "name": "rpg-maker-cheat-toolkit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:installer": "tauri dev",
    "build:overlay": "vite build --config vite.config.overlay.ts && node scripts/check-bundle.ts",
    "build:installer": "tauri build --no-bundle",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . --fix && eslint . --fix --cache",
    "lint:check": "oxlint . && eslint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run",
    "check": "bun run format:check && bun run lint:check && bun run type-check && bun run test:unit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "postcss": "^8.5.33",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
